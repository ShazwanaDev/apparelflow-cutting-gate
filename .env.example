# Postgres connection string. For local development, `npm run db:local` starts an
# in-process Postgres on port 5433 that matches the value below.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# Shows the demo role switcher and credential cards. Set to false for real users.
NEXT_PUBLIC_DEMO_MODE=true
